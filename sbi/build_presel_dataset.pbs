#!/bin/bash
#PBS -N presel_dataset
#PBS -q v1_medium24
#PBS -l select=1:ncpus=12:mem=48gb
#PBS -l walltime=03:00:00
#PBS -o logs/presel_dataset.out
#PBS -e logs/presel_dataset.err
# H3: build the PRESELECTED (trigger-passing) event dataset from ROOT (all files) so the
# classifier can be fine-tuned on the hard phase space. CPU-only feature extraction.
cd "$PBS_O_WORKDIR"
mkdir -p logs data/event_level
source ~/miniforge3/etc/profile.d/conda.sh 2>/dev/null || source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate hep-root-ml
export OMP_NUM_THREADS=12
export PYTHONPATH="$PBS_O_WORKDIR:$PYTHONPATH"
python -m data_pipeline.make_event_dataset \
    --config hh-bbbb-obj-config-hpc.json \
    --output data/event_level/event_hh4b_qcd_presel.npz \
    --skip_trigger false --num_constituents 128
