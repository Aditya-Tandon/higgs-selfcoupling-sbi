#!/bin/bash
#PBS -N nsbi_cache
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -o logs/nsbi_cache.out
#PBS -e logs/nsbi_cache.err

# Build the iteration-2 NSBI cache: event ParT scores (GPU) + reco m_HH (CPU
# clustering) + gen (m_HH, cos theta*) for signal, all row-aligned.

cd "$PBS_O_WORKDIR"
mkdir -p logs data/event_level

source ~/miniforge3/etc/profile.d/conda.sh 2>/dev/null \
  || source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate hep-root-ml

export OMP_NUM_THREADS=8

python sbi/build_nsbi_cache.py \
    --qcd-max-per-bin 40000 \
    --out data/event_level/nsbi_cache.npz
