#!/bin/bash
#PBS -N ft_presel
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=4:mem=16gb:ngpus=1
#PBS -l walltime=00:40:00
#PBS -o logs/ft_presel.out
#PBS -e logs/ft_presel.err
# H3: fine-tune the event ParT on the PRESELECTED phase space (balanced pos_weight),
# starting from best_event_model_61z973dk.pth. Small dataset (4987 events) -> quick.
cd "$PBS_O_WORKDIR"
mkdir -p logs
source ~/miniforge3/etc/profile.d/conda.sh 2>/dev/null || source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate hep-root-ml
export PYTHONPATH="$PBS_O_WORKDIR:$PYTHONPATH"
export WANDB_MODE=offline
python train_event.py --config config_event_finetune.json
